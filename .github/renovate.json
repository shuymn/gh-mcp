{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":timezone(Asia/Tokyo)"],
  "gitIgnoredAuthors": [
    "gh-mcp-maintainer[bot] <217964833+gh-mcp-maintainer[bot]@users.noreply.github.com>"
  ],
  "labels": ["dependencies"],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "internalChecksAsSuccess": true,
  "reviewersFromCodeOwners": true,
  "assignAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^server\\.lock\\.json$/"],
      "matchStrings": [
        "\"version\": \"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "github/github-mcp-server"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Taskfile\\.yml$/"],
      "matchStrings": [
        "GOLANGCI_LINT_VERSION: (?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "golangci/golangci-lint"
    }
  ],
  "packageRules": [
    {
      "description": "Propose each github-mcp-server release on its own branch so none is skipped",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["github/github-mcp-server"],
      "allowedVersions": "<=v{{major}}.{{minor}}.{{add patch 1}} || v{{major}}.{{add minor 1}}.0 || v{{add major 1}}.0.0",
      "separateMultipleMajor": true,
      "separateMultipleMinor": true,
      "separateMinorPatch": true,
      "branchTopic": "{{{depNameSanitized}}}-{{{newVersion}}}"
    },
    {
      "matchPackageNames": ["!github/github-mcp-server"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": ">=1.0.0",
      "automerge": true
    },
    {
      "description": "GitHub Actions versioning does not support semver comparison ranges",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "/^v?[1-9]\\d*(?:\\.|$)/",
      "automerge": true
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["github/github-mcp-server"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "1 day",
      "internalChecksFilter": "strict",
      "rebaseWhen": "behind-base-branch"
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["github/github-mcp-server"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["renovate:major", "dependencies"]
    }
  ]
}
